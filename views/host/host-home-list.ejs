<%- include('../partials/head') %>
  <body class="pt-20">
    <%- include('../partials/nav') %>
    <main class="container mx-auto px-4 py-8">
      <div class="mx-auto">
        <div class="mb-8">
          <h1 class="text-4xl font-bold text-gray-900 mb-4">
            <i class="fas fa-home mr-4 text-red-500"></i>Your Listed Homes
          </h1>
          <p class="text-lg text-gray-600">Manage your property listings and track their performance.</p>
        </div>

        <div class="mb-8">
          <a href="/host/add-home" class="inline-flex items-center bg-red-500 text-white py-3 px-6 rounded-lg hover:bg-red-600 transition-colors duration-200 font-medium">
            <i class="fas fa-plus mr-2"></i>Add New Home
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
          <% registeredHomes.forEach(home => { %>
            <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300">
              <div class="relative h-48 overflow-hidden">
                <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="w-full h-full object-inherit hover:scale-105 transition-transform duration-300">
                <div class="absolute top-3 left-3 bg-green-500 text-white px-3 py-1 rounded-full text-sm font-medium">
                  Listed
                </div>
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-gray-900 mb-2"><%= home.houseName %></h3>
                <p class="text-gray-600 mb-3 flex items-center">
                  <i class="fas fa-map-marker-alt mr-2 text-red-500"></i>
                  <%= home.location %>
                </p>
                <div class="flex justify-between items-center mb-4">
                  <div class="flex items-center">
                    <i class="fas fa-star text-yellow-400 mr-1"></i>
                    <span class="text-gray-700 font-medium"><%= home.rating %></span>
                  </div>
                  <div class="text-right">
                    <span class="text-2xl font-bold text-gray-900">₹<%= home.price %></span>
                    <span class="text-gray-600 text-sm">/night</span>
                  </div>
                </div>
                <div class="flex gap-3">
                  <a href="/host/edit-home/<%= home._id %>?editing=true" class="flex-1 bg-blue-500 text-white py-2 px-4 rounded-lg hover:bg-blue-600 transition-colors duration-200 text-center font-medium">
                    <i class="fas fa-edit mr-2"></i>Edit
                  </a>
                  <form action="/host/delete-home/<%= home._id %>" method="post" class="shrink-0">
                    <button type="submit" class="bg-red-100 text-red-600 py-2 px-4 rounded-lg hover:bg-red-200 transition-colors duration-200" onclick="return confirm('Are you sure you want to delete this home?')">
                      <i class="fas fa-trash"></i>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

        <% if (!registeredHomes || registeredHomes.length === 0) { %>
          <div class="text-center py-16 bg-white rounded-xl shadow-lg">
            <div class="max-w-md mx-auto">
              <i class="fas fa-home text-gray-300 text-6xl mb-6"></i>
              <h2 class="text-2xl font-semibold text-gray-900 mb-4">No homes listed yet</h2>
              <p class="text-gray-600 mb-8">Start your hosting journey by adding your first property.</p>
              <a href="/host/add-home" class="inline-flex items-center bg-red-500 text-white py-3 px-6 rounded-lg hover:bg-red-600 transition-colors duration-200 font-medium">
                <i class="fas fa-plus mr-2"></i>Add Your First Home
              </a>
            </div>
          </div>
        <% } %>
      </div>
    </main>
  </body>
</html>