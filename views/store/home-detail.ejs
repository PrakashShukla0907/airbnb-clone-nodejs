<%- include('../partials/head') %>
<body class="bg-gray-50 pt-20">
<%- include('../partials/nav') %>

<main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-6 md:mt-10">

    <!-- Title -->
    <div class="mb-8">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900">
            <%= home.houseName %>
        </h2>
        <p class="text-gray-600 mt-1 text-sm sm:text-base">
            <i class="fas fa-map-marker-alt mr-1"></i> <%= home.location %>
        </p>
    </div>

    <!-- Image + Booking -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 xl:gap-12 mb-12">

        <!-- Image -->
        <div class="lg:col-span-1 rounded-2xl overflow-hidden shadow-lg">
            <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>"
                 class="w-full h-56 sm:h-65 md:h-96 lg:h-120
                        object-inherit hover:scale-105 transition duration-500">
        </div>

        <!-- Booking Card (Desktop only) -->
        <div class="hidden lg:block">
            <div class="bg-white rounded-2xl shadow-xl p-6 border sticky top-28">
                
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <span class="text-3xl font-bold text-gray-900">₹ <%= home.price %></span>
                        <span class="text-gray-600 text-sm">/ night</span>
                    </div>
                    <div class="flex items-center bg-gray-100 px-3 py-1 rounded-full">
                        <span class="text-yellow-500 mr-1">★</span>
                        <span class="font-bold text-sm"><%= home.rating %></span>
                    </div>
                </div>

                <div class="space-y-4">
                    <div class="flex justify-center">
                        <%- include('../partials/favourite', { home }) %>
                    </div>

                    <button
                        class="w-full bg-linear-to-r from-red-500 to-rose-600
                               text-white py-4 rounded-xl font-bold
                               hover:shadow-xl transition">
                        <i class="fas fa-calendar-check mr-2"></i> Reserve Now
                    </button>

                    <p class="text-center text-xs text-gray-500">
                        You won’t be charged yet
                    </p>
                </div>
            </div>
        </div>

        <div class="space-y-8">

            <!-- Host -->
            <div class="bg-gray-50 rounded-2xl p-6 border">
                <h3 class="text-lg font-bold mb-4 flex items-center">
                    <i class="fas fa-user-shield mr-3 text-purple-500"></i>
                    Meet your Host
                </h3>

                <div class="flex items-center">
                    <div
                        class="w-14 h-14 rounded-full bg-linear-to-tr from-gray-300 to-gray-500
                               flex items-center justify-center mr-4">
                        <i class="fas fa-user text-white"></i>
                    </div>
                    <div>
                        <p class="font-bold text-gray-800">Local Host</p>
                        <p class="text-sm text-gray-500">Identity Verified</p>
                    </div>
                </div>
            </div>

            <!-- Reviews -->
            <div class="bg-white rounded-2xl p-6 border shadow-sm">
                <h3 class="text-lg font-bold mb-4 flex items-center">
                    <i class="fas fa-star mr-3 text-yellow-500"></i>
                    Reviews
                </h3>

                <div class="flex items-center mb-3">
                    <span class="text-3xl font-bold"><%= home.rating %></span>
                    <div class="ml-3 text-yellow-400 text-sm">★★★★★</div>
                </div>

                <p class="text-gray-600 italic text-sm">
                    “The cleanliness was exceptional and the host was very responsive!”
                </p>
            </div>

        </div>

    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 xl:gap-14 border-t pt-10">

        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-12">

            <!-- About -->
            <section>
                <h3 class="text-xl sm:text-2xl font-semibold mb-4 flex items-center">
                    <i class="fas fa-info-circle mr-3 text-blue-500"></i>
                    About this place
                </h3>
                <p class="text-gray-700 leading-relaxed text-base sm:text-lg">
                    <%= home.discription %>
                </p>
            </section>

            <!-- Location -->
            <section>
                <h3 class="text-xl sm:text-2xl font-semibold mb-4 flex items-center">
                    <i class="fas fa-map-marker-alt mr-3 text-red-500"></i>
                    Where you’ll be
                </h3>
                <p class="text-gray-700 mb-4"><%= home.location %></p>

                <div class="w-full h-64 bg-gray-100 rounded-2xl border-2 border-dashed
                            flex items-center justify-center">
                    <div class="text-center text-gray-500">
                        <i class="fas fa-map-marked-alt text-4xl mb-2"></i>
                        <p class="font-medium">Map view coming soon</p>
                    </div>
                </div>
            </section>
            

        </div>

        <!-- Sidebar -->
        
    </div>

    <!-- Features -->
    <div class="mt-16 mb-20 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

        <div class="flex items-start p-5 rounded-xl hover:bg-gray-50 transition">
            <i class="fas fa-home text-2xl text-blue-500"></i>
            <div class="ml-4">
                <h4 class="font-bold">Entire home</h4>
                <p class="text-sm text-gray-600">You’ll have the space to yourself</p>
            </div>
        </div>

        <div class="flex items-start p-5 rounded-xl hover:bg-gray-50 transition">
            <i class="fas fa-spray-can text-2xl text-green-500"></i>
            <div class="ml-4">
                <h4 class="font-bold">Enhanced Clean</h4>
                <p class="text-sm text-gray-600">Sanitized to safety standards</p>
            </div>
        </div>

        <div class="flex items-start p-5 rounded-xl hover:bg-gray-50 transition">
            <i class="fas fa-key text-2xl text-purple-500"></i>
            <div class="ml-4">
                <h4 class="font-bold">Self check-in</h4>
                <p class="text-sm text-gray-600">Secure keypad access</p>
            </div>
        </div>

    </div>

</main>
</body>
</html>
