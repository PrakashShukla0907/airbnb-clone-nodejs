<%- include('../partials/head') %>
  <body class="pt-20">
    <%- include('../partials/nav') %>
    <main class="container mx-auto px-4 py-8">
      <div class="mx-auto">
        <div class="mb-8 text-center">
          <h1 class="text-4xl font-bold text-gray-900 mb-4">Your Favourite Homes</h1>
          <p class="text-lg text-gray-600">Places you've saved for later. Keep track of the homes you love.</p>
        </div>

        <% if (favouriteHomes && favouriteHomes.length > 0) { %>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            <% favouriteHomes.forEach(home => { %>
              <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
                <div class="relative h-48 overflow-hidden">
                  <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300">
                  <div class="absolute top-3 right-3 bg-red-500 rounded-full p-2 shadow-md">
                    <i class="fas fa-heart text-white"></i>
                  </div>
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-semibold text-gray-900 mb-2"><%= home.houseName %></h3>
                  <p class="text-gray-600 mb-3 flex items-center">
                    <i class="fas fa-map-marker-alt mr-2 text-red-500"></i>
                    <%= home.location %>
                  </p>
                  <div class="flex justify-between items-center mb-4">
                    <div class="flex items-center">
                      <i class="fas fa-star text-yellow-400 mr-1"></i>
                      <span class="text-gray-700 font-medium"><%= home.rating %></span>
                    </div>
                    <div class="text-right">
                      <span class="text-2xl font-bold text-gray-900">₹<%= home.price %></span>
                      <span class="text-gray-600 text-sm">/night</span>
                    </div>
                  </div>
                  <div class="flex gap-3">
                    <a href="/homes/<%= home._id %>" class="flex-1 bg-red-500 text-white py-2 px-4 rounded-lg hover:bg-red-600 transition-colors duration-200 text-center font-medium">
                      <i class="fas fa-eye mr-2"></i>View Details
                    </a>
                    <form action="/favourites/delete/<%= home._id %>" method="POST" class="shrink-0">
                      <button type="submit" class="bg-gray-200 text-gray-700 py-2 px-4 rounded-lg hover:bg-red-100 hover:text-red-600 transition-colors duration-200">
                        <i class="fas fa-trash"></i>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-16">
            <div class="max-w-md mx-auto">
              <i class="fas fa-heart text-gray-300 text-6xl mb-6"></i>
              <h2 class="text-2xl font-semibold text-gray-900 mb-4">No favourites yet</h2>
              <p class="text-gray-600 mb-8">Start exploring homes and save your favourites for easy access later.</p>
              <a href="/homes" class="inline-flex items-center bg-red-500 text-white py-3 px-6 rounded-lg hover:bg-red-600 transition-colors duration-200 font-medium">
                <i class="fas fa-search mr-2"></i>Browse Homes
              </a>
            </div>
          </div>
        <% } %>
      </div>
    </main>
  </body>
</html>