<%- include('../partials/head') %>
  <body class="pt-20">
    <%- include('../partials/nav') %>
    <main class="container mx-auto px-4 py-8">
      <div class="mx-auto">
        <div class="text-center mb-12">
          <h1 class="text-4xl font-bold text-gray-900 mb-4">
            <i class="fas fa-calendar-check mr-4 text-red-500"></i>My Bookings
          </h1>
          <p class="text-lg text-gray-600">Manage your upcoming stays and travel plans</p>
        </div>

        <div class="bg-white rounded-xl shadow-lg p-12 text-center">
          <div class="max-w-md mx-auto">
            <i class="fas fa-calendar-alt text-gray-300 text-6xl mb-6"></i>
            <h2 class="text-2xl font-semibold text-gray-900 mb-4">No bookings yet</h2>
            <p class="text-gray-600 mb-8">You haven't made any bookings. Start exploring amazing homes and plan your next adventure!</p>
            <div class="space-y-4">
              <a href="/homes" class="inline-flex items-center bg-red-500 text-white py-3 px-6 rounded-lg hover:bg-red-600 transition-colors duration-200 font-medium mr-4">
                <i class="fas fa-search mr-2"></i>Browse Homes
              </a>
              <a href="/favourites" class="inline-flex items-center bg-gray-200 text-gray-700 py-3 px-6 rounded-lg hover:bg-gray-300 transition-colors duration-200 font-medium">
                <i class="fas fa-heart mr-2"></i>View Favourites
              </a>
            </div>
          </div>
        </div>

        <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white rounded-xl shadow-lg p-6 text-center">
            <i class="fas fa-search text-3xl text-blue-500 mb-4"></i>
            <h3 class="text-lg font-semibold mb-2">Find Your Perfect Stay</h3>
            <p class="text-gray-600 text-sm">Browse thousands of unique homes worldwide</p>
          </div>
          <div class="bg-white rounded-xl shadow-lg p-6 text-center">
            <i class="fas fa-calendar-check text-3xl text-green-500 mb-4"></i>
            <h3 class="text-lg font-semibold mb-2">Easy Booking</h3>
            <p class="text-gray-600 text-sm">Book instantly with our secure platform</p>
          </div>
          <div class="bg-white rounded-xl shadow-lg p-6 text-center">
            <i class="fas fa-star text-3xl text-yellow-500 mb-4"></i>
            <h3 class="text-lg font-semibold mb-2">Host Reviews</h3>
            <p class="text-gray-600 text-sm">Read reviews from real guests</p>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>